// jsonInteger reports whether the bytes of a JSON number hold an integer
// value: no fraction, and no exponent that gives one.
func jsonInteger(data []byte) bool {
	const decimal = "0123456789"

	text := strings.TrimPrefix(string(data), "-")

	mantissa, exponent := text, ""
	if i := strings.IndexAny(text, "eE"); i >= 0 {
		mantissa, exponent = text[:i], text[i+1:]

		if exponent == "" {
			return false
		}
	}

	intPart, fracPart, hasPoint := strings.Cut(mantissa, ".")

	if intPart == "" || strings.Trim(intPart, decimal) != "" ||
		(hasPoint && (fracPart == "" || strings.Trim(fracPart, decimal) != "")) {
		return false
	}

	exp := 0

	if exponent != "" {
		n, err := strconv.Atoi(exponent)
		if err != nil {
			return false
		}

		exp = n
	}

	digits := strings.TrimLeft(intPart+fracPart, "0")
	if digits == "" {
		return true
	}

	shift := exp - len(fracPart)
	if shift >= 0 {
		return true
	}

	if -shift > len(digits) {
		return false
	}

	return strings.Trim(digits[len(digits)+shift:], "0") == ""
}
