// requireFields checks that a JSON object holds every required member, and that
// a member that cannot be null is not null. Go decodes null into a string, a
// number or a bool as no change, so the check is here and not in the decoder.
func requireFields(data []byte, required, notNull []string) error {
	var members map[string]json.RawMessage
	if err := json.Unmarshal(data, &members); err != nil {
		return err
	}

	if members == nil {
		return fmt.Errorf("the value is null and an object is needed")
	}

	for _, name := range required {
		if _, ok := members[name]; !ok {
			return fmt.Errorf("the member %q is missing", name)
		}
	}

	for _, name := range notNull {
		if bytes.Equal(bytes.TrimSpace(members[name]), []byte("null")) {
			return fmt.Errorf("the member %q is null and a value is needed", name)
		}
	}

	return nil
}
