// UnmarshalJSON rejects a value that is not in the list.
func (v *{{$t.Name}}) UnmarshalJSON(data []byte) error {
	var s string
	if err := json.Unmarshal(data, &s); err != nil {
		return err
	}

	switch {{$t.Name}}(s) {
	case {{range $i, $v := $t.Values}}{{if $i}}, {{end}}{{$v.Const}}{{end}}:
		*v = {{$t.Name}}(s)

		return nil
	}

	return fmt.Errorf("%q is not a value of {{$t.Name}}", s)
}
