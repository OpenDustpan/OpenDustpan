// UnmarshalJSON accepts only the JSON types of the list.
func (v *{{$t.Name}}) UnmarshalJSON(data []byte) error {
	kind := jsonKind(data)
{{- if $t.Integer}}

	if kind == "number" && !jsonInteger(data) {
		return fmt.Errorf("want {{$t.ChoiceText}}, got a number that is not an integer")
	}
{{- end}}

	switch kind {
	case {{range $i, $k := $t.Choice}}{{if $i}}, {{end}}{{goString $k}}{{end}}:
		*v = {{$t.Name}}(append([]byte(nil), data...))

		return nil
	default:
		return fmt.Errorf("want {{$t.ChoiceText}}, got %s", kind)
	}
}

// MarshalJSON writes the value back.
func (v {{$t.Name}}) MarshalJSON() ([]byte, error) {
	if len(v) == 0 {
		return nil, fmt.Errorf("{{$t.Name}} holds no JSON value")
	}

	return v, nil
}
