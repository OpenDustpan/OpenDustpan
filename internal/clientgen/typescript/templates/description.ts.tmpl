/**
 * The bytes of the API description that this package was generated from, as
 * text: one string for each line, joined with a line feed. A published
 * package has the SHA-256 of its UTF-8 encoding in metadata.descriptionSha256.
 */
export const description: string = [
{{- range .DescriptionLines}}
  {{.}},
{{- end}}
].join("\n");
