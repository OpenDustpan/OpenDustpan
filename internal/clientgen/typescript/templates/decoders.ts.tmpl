{{.Header}}

import {
  anyValue,
  array,
  boolean,
  closedEnum,
  dateTime,
  int64,
  literal,
  nullable,
  number,
  object,
  openEnum,
  optional,
  record,
  ref,
  string,
  union,
} from "./decode.js";
import type { Decoder } from "./decode.js";
{{- if .UsesOneOf}}
import { invalidValue } from "./errors.js";
{{- end}}
import type {
{{- range .Types}}
  {{.Name}},
{{- end}}
} from "./types.js";
import {
{{- range .Types}}{{if or .IsClosedEnum .IsOpenEnum}}
  {{.Name}}Values,
{{- end}}{{end}}
} from "./types.js";
{{- if .UsesOneOf}}

/**
 * The validator of a value that is one of several types. It tries each
 * validator in order and gives the first value that one of them accepts.
 */
function oneOf<T>(want: string, ...decoders: ReadonlyArray<Decoder<T>>): Decoder<T> {
  return (value, path) => {
    for (const decode of decoders) {
      try {
        return decode(value, path);
      } catch {
        // The value is not of this type. The next validator gets it.
      }
    }

    const kind = typeof value;
    const article = /^[aeiou]/.test(kind) ? "an" : "a";
    const got = value === null ? "null" : Array.isArray(value) ? "an array" : `${article} ${kind}`;

    throw invalidValue(path, `want ${want}, got ${got}`);
  };
}
{{- end}}
{{range $t := .Types}}
{{if $t.IsInterface -}}
/** The validator of {{$t.Name}}. */
export const decode{{$t.Name}}: Decoder<{{$t.Name}}> = object<{{$t.Name}}>({{tsString $t.Name}}, {
{{- range $t.Fields}}
  {{.Name}}: {{if .Optional}}optional({{.Decoder}}){{else}}{{.Decoder}}{{end}},
{{- end}}
});
{{- else if $t.IsUnion -}}
/** The validator of {{$t.Name}}. A value of {{$t.Discriminator}} that no variant names gets the validator of {{$t.Base}}. */
export const decode{{$t.Name}}: Decoder<{{$t.Name}}> = union<{{$t.Name}}>({{tsString $t.Name}}, {{$t.Discriminator}}, {
{{- range $t.Variants}}
  {{.Value}}: ref(() => decode{{.Name}}),
{{- end}}
}, ref(() => decode{{$t.Base}}));
{{- else if $t.IsRecord -}}
/** The validator of {{$t.Name}}. */
export const decode{{$t.Name}}: Decoder<{{$t.Name}}> = record({{$t.RecordDecoder}});
{{- else if $t.IsClosedEnum -}}
/** The validator of {{$t.Name}}. It refuses a value that is not in the list. */
export const decode{{$t.Name}}: Decoder<{{$t.Name}}> = closedEnum({{tsString $t.Name}}, {{$t.Name}}Values);
{{- else -}}
/** The validator of {{$t.Name}}. It keeps a value that is not in the list. */
export const decode{{$t.Name}}: Decoder<{{$t.Name}}> = openEnum<{{$t.Name}}>({{tsString $t.Name}});
{{- end}}
{{end}}
