{
  "gates": [
    {"id": "acme/cost-block", "scope": {"level": "namespace", "name": "acme"}, "decisionPoint": "change.planned",
     "condition": "context.cost.available && context.cost.deltaMonthly > 50000", "outcome": "deny",
     "message": "Monthly cost grows by more than 500.00 USD.", "mode": "enforce"}
  ],
  "cases": [
    {"name": "small change passes",
     "subject": {"tool": "opentofu", "namespace": "acme", "collection": "prod", "name": "prod/net"},
     "principal": {"id": "alice"},
     "facts": {"operation": "apply", "unit": {"collection": "prod", "labels": []}, "plan": {"create": 1, "update": 0, "delete": 0, "replace": 0},
               "cost": {"deltaMonthly": 100, "available": true}, "change": {"paths": [], "inputKeys": []}},
     "expect": {"result": "allow"}},
    {"name": "large change is denied",
     "subject": {"tool": "opentofu", "namespace": "acme", "collection": "prod", "name": "prod/net"},
     "principal": {"id": "alice"},
     "facts": {"operation": "apply", "unit": {"collection": "prod", "labels": []}, "plan": {"create": 1, "update": 0, "delete": 0, "replace": 0},
               "cost": {"deltaMonthly": 90000, "available": true}, "change": {"paths": [], "inputKeys": []}},
     "expect": {"result": "deny", "matched": ["acme/cost-block"]}}
  ]
}
