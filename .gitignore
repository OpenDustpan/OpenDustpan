# Build output: make build and make build-launcher write bin/opendustpan and bin/dustpan-launcher.
/bin/
*.exe
*.test
*.out

# Local databases and data
*.db
*.db-shm
*.db-wal
/data/

# Editors and OS
.DS_Store
.idea/
.vscode/

# End-to-end request logs and reports
/e2e/report/
/opendustpan

# Load harness report (make load writes it next to the Makefile)
load-report.json
perf-out/
bench-s3-out/

# Soak run reports (make soak writes CSV and Markdown here)
soak-reports/

# Local agent config (see docs/agents/local-setup.md)
/opencode.local.jsonc

# Coverage profile (make cover writes it next to the Makefile)
coverage.out

# Repowise local files. decisions.yaml stays tracked.
/.repowise/*
!/.repowise/decisions.yaml

# The baseline hash files return at the first tag; the release writes them.
pkg/store/*/migrations/*.sql.sha256
