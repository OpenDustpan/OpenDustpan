{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  // Some model providers refuse the gopls MCP tool schema, with a provider error 400 on gopls_go_diagnostics.
  // To run OpenCode with the gopls tools turned off, set the environment variable OPENCODE_CONFIG_CONTENT to the JSON text {"mcp":{"gopls":{"enabled":false}}}, for that run only.
  // This file is not changed by that run.
  "mcp": {
    "gopls": {
      "type": "local",
      "command": [
        "gopls",
        "mcp"
      ],
      "enabled": true
    }
  },
  // The model advertises a 1,048,576-token window, but a request is rejected
  // once input + the 131,072 output reservation exceeds it.
  "provider": {
    "opencode-go": {
      "models": {
        "muse-spark-1.3-contributor": {
          "limit": {
            "context": 400000,
            "output": 32000
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 40000
  }
}
