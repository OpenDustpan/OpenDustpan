{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "gopls": {
      "type": "local",
      "command": [
        "gopls",
        "mcp"
      ],
      "enabled": true
    },
    "repowise": {
      "type": "remote",
      "url": "https://api.repowise.dev/mcp/w/6092d588-b806-4005-8af9-efdb7abf90de",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer MY_API_KEY"
      }
    }
  },
  // The model advertises a 1,048,576-token window, but a request is rejected
  // once input + the 131,072 output reservation exceeds it.
  "provider": {
    "opencode-go": {
      "models": {
        "muse-spark-1.3-contributor": {
          "limit": {
            "context": 400000,
            "output": 32000
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 40000
  }
}
