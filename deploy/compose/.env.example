# Do not copy this file by hand. Run ./init.sh: it writes .env with random
# values and mode 0600. This file names each variable.

# The password of the PostgreSQL user dustpan.
POSTGRES_PASSWORD=
# The access key and the secret key of the S3-compatible store.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# The bootstrap administrator token (at least 32 bytes).
DUSTPAN_ADMIN_TOKEN=
# The key-encryption key (32 random bytes in base64). A lost key loses every
# secret and every OpenTofu state.
DUSTPAN_KEY_ENCRYPTION_KEY=

# Optional. The host port on 127.0.0.1 (default 8080).
# OPENDUSTPAN_PORT=8080
# Optional. An image from a release, with its version and digest.
# OPENDUSTPAN_IMAGE=
