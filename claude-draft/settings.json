  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": [
        "~/.config/gh",
        "~/.git-credentials",
        "~/.ssh",
        "~/.netrc",
        "~/.claude/.credentials.json",
        "~/.aws",
        "~/.npmrc",
        "~/.config/git/credentials",
        "~/.claude.json",
        "~/.claude.json.backup*",
        "~/.claude/backups",
        "~/_netrc"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "attribution": {
    "sessionUrl": false
  }
}
